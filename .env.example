# ============================================================================
# MirLeon (SİTS/Nazar) — Ortam Değişkenleri ŞABLONU
# ----------------------------------------------------------------------------
# Bu dosya SADECE anahtar İSİMLERİNİ listeler; GERÇEK DEĞER İÇERMEZ ve git'e
# girer. Kurulum: bu dosyayı ".env.local" olarak kopyala ve değerleri doldur.
#   cp .env.example .env.local
# Gerçek anahtar değerleri ASLA git'e konmaz; ekip içinde parola yöneticisi /
# güvenli kanal ile paylaşılır. (.env.local .gitignore ile hariç tutulur.)
# "opsiyonel" işaretliler yoksa ilgili özellik sessizce devre dışı kalır.
# ============================================================================

# ---- FIREBASE (istemci tarafı — herkese açık, yine de zorunlu) --------------
# Firebase Console > Proje Ayarları > Genel > "Web uygulaması" yapılandırması
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- reCAPTCHA v3 (istemci — bot/rate koruması) — opsiyonel -----------------
# https://www.google.com/recaptcha/admin  (v3 site anahtarı)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ---- YAPAY ZEKA -------------------------------------------------------------
ANTHROPIC_API_KEY=          # https://console.anthropic.com  — mesaj/analiz LLM (ana)
GEMINI_API_KEY=             # https://aistudio.google.com/apikey  — yedek/görsel LLM (opsiyonel)

# ---- OSINT / TEHDİT İSTİHBARATI (çoğu opsiyonel; yoksa o sinyal atlanır) -----
VIRUSTOTAL_KEY=             # https://www.virustotal.com/gui/my-apikey
ABUSEIPDB_KEY=              # https://www.abuseipdb.com/account/api
ABUSECH_KEY=               # https://auth.abuse.ch  — URLhaus / ThreatFox
IPQS_KEY=                  # https://www.ipqualityscore.com  — IP/URL itibarı
GOOGLE_SAFEBROWSING_KEY=    # Google Cloud > Safe Browsing API anahtarı
SAFE_BROWSING_KEY=          # (bazı uçlar bu isimle okur — GOOGLE_SAFEBROWSING_KEY ile aynı değeri ver)
URLSCAN_KEY=               # https://urlscan.io/user/apikey  (web + worker ile ORTAK)
SSLMATE_API_KEY=           # https://sslmate.com/ct_search_api  — CertSpotter/CT arama
SEON_KEY=                  # https://seon.io  — fraud/e-posta itibarı (opsiyonel)
OSINT_INDUSTRIES_KEY=      # https://osint.industries  (opsiyonel; anahtarsız kapalı)
SOCIALLINKS_KEY=           # SocialLinks sağlayıcı anahtarı (opsiyonel)
SOCIALLINKS_URL=           # SocialLinks API kök adresi (opsiyonel)
WHATSMYNAME=               # WhatsMyName kullanıcı-adı OSINT — "1" ile aç (opsiyonel)
GCP_SA_KEY=                # Google Cloud service account JSON (tek satır) — Safe Browsing/Web Risk (opsiyonel)

# ---- GÖRSEL DENETİM (sahte logo/görsel) — opsiyonel -------------------------
SIGHTENGINE_USER=          # https://sightengine.com  (API user)
SIGHTENGINE_SECRET=        # https://sightengine.com  (API secret)

# ---- E-POSTA (rapor/uyarı gönderimi) — opsiyonel ----------------------------
RESEND_API_KEY=            # https://resend.com  — API anahtarı
MAIL_FROM=                 # gönderen adresi (ör. uyari@mirleon.ai)

# ---- META (sahte reklam / marka izleme) — opsiyonel ------------------------
META_AD_TOKEN=             # https://developers.facebook.com  — Ad Library API erişim tokenı

# ---- GITHUB (opsiyonel otomasyon) ------------------------------------------
GITHUB_TOKEN=              # GitHub Personal Access Token

# ---- İÇ SIRLAR (üçüncü taraf DEĞİL — rastgele üret: `openssl rand -hex 32`) --
# Bunlar uç-noktaları korur; değerleri sen belirlersin, kimseden alınmaz.
ADMIN_KEY=                 # yönetim/temizlik uçları
CRON_SECRET=               # zamanlanmış görev (cron) doğrulaması
IZLEME_SECRET=             # e-posta/izleme uçları
MARKA_ADAY_SECRET=         # worker → /api/marka-aday kimliği — WORKER İLE AYNI OLMALI

# ============================================================================
# CERTSTREAM WORKER (certstream-worker/ — Fly.io'da `flyctl secrets set K=V -a <app>`)
# 5 uygulama: sits-marka-avci, sits-marka-avci-asia, sits-ct-digicert,
#             sits-ct-google, sits-ct-sectigo
# ----------------------------------------------------------------------------
# GİZLİ (secret):
#   SITS_URL=https://siber-bildir-web.vercel.app   # worker → web API kökü
#   MARKA_ADAY_SECRET=<web ile AYNI değer>
#   URLSCAN_KEY=<web ile aynı olabilir>
# AYAR BAYRAKLARI (secret değil — görev ayrımı):
#   BAHIS_AKTIF=0|1  AKTIF_TARAMA=0|1  CT_ONLY_OP  CT_SKIP_OP
#   CT_MAX_LOG  CT_KOPMA_ESIK  GONDER_ES  POS_FILE  PORT
# ============================================================================
