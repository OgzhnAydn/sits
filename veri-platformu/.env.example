# SİTS Veri Platformu — ortam değişkenleri.
# KULLANIM:  cp .env.example .env   (sonra parolaları değiştir)   →   docker compose --env-file .env up -d
# .env dosyasını ASLA git'e ekleme (parola içerir).

CLICKHOUSE_USER=sits
CLICKHOUSE_PASSWORD=degistir-guclu-bir-parola
NEO4J_PASSWORD=degistir-guclu-bir-parola

# TR-vantage render servisi
RENDER_SECRET=degistir-render-sir
# TR residential proxy (opsiyonel; yoksa sunucu IP'sinden tarar). Örn: http://kullanici:parola@gateway:port
TR_PROXY=
